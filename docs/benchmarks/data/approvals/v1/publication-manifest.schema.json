{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nara.reference-game.publication-manifest-v1",
  "title": "Nara Reference-Game Publication Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format_version",
    "approval",
    "repository",
    "source_revision",
    "protocol_sha256",
    "version",
    "tag",
    "publisher",
    "release",
    "candidates",
    "checksum_file"
  ],
  "properties": {
    "schema": {
      "const": "nara.reference-game.publication-manifest-v1"
    },
    "format_version": {
      "const": 1
    },
    "approval": {
      "type": "object"
    },
    "repository": {
      "type": "string"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string"
    },
    "tag": {
      "type": "object"
    },
    "publisher": {
      "type": "object"
    },
    "release": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "checksum_file": {
      "type": "object"
    }
  }
}
