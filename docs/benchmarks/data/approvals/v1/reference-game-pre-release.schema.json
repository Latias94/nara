{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nara.reference-game.pre-release-approval-v1",
  "title": "Nara Reference-Game Pre-release Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format_version",
    "decision",
    "version",
    "repository",
    "source_revision",
    "protocol_sha256",
    "publisher",
    "normalized_evidence",
    "journey",
    "review",
    "next_slice",
    "release_notes",
    "candidates"
  ],
  "properties": {
    "schema": {
      "const": "nara.reference-game.pre-release-approval-v1"
    },
    "format_version": {
      "const": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "Publish",
        "Redirect",
        "Stop"
      ]
    },
    "version": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_path",
        "definition_sha256",
        "source_revision"
      ],
      "properties": {
        "workflow_path": {
          "const": ".github/workflows/reference-game-release.yml"
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "normalized_evidence": {
      "type": "object"
    },
    "journey": {
      "type": "object"
    },
    "review": {
      "type": "object"
    },
    "next_slice": {
      "type": "object"
    },
    "release_notes": {
      "type": "object"
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    }
  }
}
