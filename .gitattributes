# GitHub workflow policy fixtures must be byte-stable across runner platforms.
.github/workflows/* text eol=lf

# Canonical JSON fixtures and schema catalogs are byte-for-byte protocol evidence.
tests/fixtures/**/*.json text eol=lf
tests/fixtures/**/*.ron text eol=lf
reference-game/schema/*.json text eol=lf
reference-game/tests/data/*.command text eol=lf

# Reference-game project sources participate in cross-platform content revisions.
reference-game/nara.toml text eol=lf
reference-game/scenes/*.json text eol=lf
reference-game/prefabs/*.json text eol=lf
reference-game/assets/**/*.meta text eol=lf

# Canonical U22 evidence is hashed byte-for-byte.
docs/benchmarks/data/**/*.json text eol=lf
docs/benchmarks/data/**/*.jsonl text eol=lf
docs/benchmarks/data/**/*.blake3 text eol=lf
docs/benchmarks/data/**/*.base64 text eol=lf
