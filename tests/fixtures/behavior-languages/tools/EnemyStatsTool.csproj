<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>EnemyStatsTool</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ToolRevision Condition="'$(ToolRevision)' == ''">1</ToolRevision>
    <DefineConstants Condition="'$(ToolRevision)' == '2'">$(DefineConstants);TOOL_REVISION_TWO</DefineConstants>
    <DefineConstants Condition="'$(ToolRevision)' == 'invalid'">$(DefineConstants);TOOL_REVISION_INVALID</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="enemy-stats.catalog.json"
                      LogicalName="enemy-stats.catalog.json"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
