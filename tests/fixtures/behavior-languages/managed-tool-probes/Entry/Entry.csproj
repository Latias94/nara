<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nara.SourceToolProbe</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProbeMode Condition="'$(ProbeMode)' == ''">sync</ProbeMode>
    <DefineConstants Condition="'$(ProbeMode)' == 'async'">$(DefineConstants);PROBE_ASYNC</DefineConstants>
    <DefineConstants Condition="'$(ProbeMode)' == 'sta'">$(DefineConstants);PROBE_STA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dependency/Dependency.csproj" />
  </ItemGroup>
</Project>
